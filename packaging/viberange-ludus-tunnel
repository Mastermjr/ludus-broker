#!/bin/sh
set -eu

: "${CREDENTIALS_DIRECTORY:?systemd credential directory is required}"
: "${VBR_LUDUS_SSH_TARGET:?set VBR_LUDUS_SSH_TARGET in broker.env}"

local_port=${VBR_LUDUS_TUNNEL_LOCAL_PORT:-18080}
remote_host=${VBR_LUDUS_TUNNEL_REMOTE_HOST:-127.0.0.1}
remote_port=${VBR_LUDUS_TUNNEL_REMOTE_PORT:-8080}

exec /usr/bin/ssh -NT \
  -i "$CREDENTIALS_DIRECTORY/ludus-tunnel" \
  -o IdentitiesOnly=yes \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=yes \
  -o "UserKnownHostsFile=$CREDENTIALS_DIRECTORY/ludus-known-hosts" \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o ConnectTimeout=15 \
  -L "127.0.0.1:${local_port}:${remote_host}:${remote_port}" \
  "$VBR_LUDUS_SSH_TARGET"
