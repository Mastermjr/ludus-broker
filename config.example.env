VBR_DATABASE_PATH=/var/lib/viberange-broker/state/broker.db
VBR_BACKUP_AGE_RECIPIENT=age1example_replace_with_operator_recovery_recipient
VBR_MODE=simulation
VBR_SLOT_IDS=user1,user2,user3,user4,user5
VBR_LEASE_DURATION=1h
VBR_REJOIN_COOLDOWN=30m
VBR_PREPARATION_LEAD=15m
VBR_NO_SHOW_GRACE=10m
VBR_LUDUS_URL=https://ludus-management.example:8080
VBR_LUDUS_API_KEY_FILE=/run/credentials/viberange-broker.service/ludus-api-key
VBR_LUDUS_TLS_CERT_SHA256=
# Use one global exact hash only when every slot config is byte-identical.
VBR_LUDUS_BLUEPRINT_SHA256=
# Otherwise provide every configured slot's exact approved hash:
VBR_LUDUS_BLUEPRINT_SHA256_BY_SLOT=
VBR_LUDUS_INSECURE_SKIP_VERIFY=false
# Optional only when direct private-network API access is unavailable:
VBR_LUDUS_SSH_TARGET=operator@ludus-management.example
VBR_LUDUS_TUNNEL_LOCAL_PORT=18080
VBR_LUDUS_TUNNEL_REMOTE_HOST=127.0.0.1
VBR_LUDUS_TUNNEL_REMOTE_PORT=8080
VBR_DISCORD_TOKEN_FILE=/run/credentials/viberange-broker.service/discord-token
VBR_DISCORD_GUILD_ID=
VBR_DISCORD_CHANNEL_ID=
VBR_DISCORD_PARTICIPANT_ROLE_ID=
